rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerifiedWmuUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@wmich[.]edu');
    }

    function isOwner(uid) {
      return isVerifiedWmuUser() && request.auth.uid == uid;
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isRequiredString(value, maxLength) {
      return isString(value, maxLength) && value.size() > 0;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'preferredName', 'joinedTerm', 'requirements', 'updatedAt'])
        && data.keys().hasAll(['firstName', 'lastName', 'preferredName', 'joinedTerm', 'requirements', 'updatedAt'])
        && isRequiredString(data.firstName, 60)
        && isRequiredString(data.lastName, 60)
        && isRequiredString(data.preferredName, 60)
        && isRequiredString(data.joinedTerm, 20)
        && data.requirements is map
        && data.requirements.size() <= 10
        && data.updatedAt == request.time;
    }

    function isValidOrganization(data) {
      return data.keys().hasOnly(['name', 'contactName', 'mailingAddress', 'contactInfo', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'contactName', 'mailingAddress', 'contactInfo', 'createdAt', 'updatedAt'])
        && isRequiredString(data.name, 120)
        && isString(data.contactName, 120)
        && isString(data.mailingAddress, 300)
        && isString(data.contactInfo, 150)
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);

      match /organizations/{orgId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidOrganization(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && isValidOrganization(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }
    }
  }
}